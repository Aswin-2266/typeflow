{
  "name": "typeflow",
  "version": "0.2.0",
  "private": true,
  "description": "A typing test with independently deployable web and API applications.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @typeflow/web",
    "dev:api": "npm run dev --workspace @typeflow/api",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "build": "npm run build --workspace @typeflow/shared && npm run build --workspace @typeflow/web && npm run build --workspace @typeflow/api",
    "build:web": "npm run build --workspace @typeflow/web",
    "build:api": "npm run build --workspace @typeflow/api",
    "test": "npm run test --workspace @typeflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --ext .ts",
    "lint:fix": "eslint apps packages --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,scss,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "prettier": "^3.3.2",
    "typescript": "5.5.4"
  }
}
