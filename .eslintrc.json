{
    "env": {
        "node": true,
        "es2021": true
    },
    "overrides": [],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "ignorePatterns": ["**/*.json"],
    "root": true,
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
         "ecmaFeatures": {
            "jsx": true
        }
    },
    "rules": {
        "semi": [
            "error",
            "never"
        ],
        "quotes": [
            "error",
            "double"
        ]
    }
}